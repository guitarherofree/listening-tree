diff --git a/src/project/internal/opensaveprojectscenario.cpp b/src/project/internal/opensaveprojectscenario.cpp
index d6917c9531054e1fbe679c080a54dac3eb3ad7cb..7f4fddb2a0261073f60fda6062bac9b49d21c6d8 100644
--- a/src/project/internal/opensaveprojectscenario.cpp
+++ b/src/project/internal/opensaveprojectscenario.cpp
@@ -241,13 +241,10 @@ RetVal<muse::io::path_t> OpenSaveProjectScenario::askLocalPath(IAudacityProjectP
 
 RetVal<SaveLocationType> OpenSaveProjectScenario::saveLocationType() const
 {
-    bool shouldAsk = configuration()->shouldAskSaveLocationType();
-    SaveLocationType lastUsed = configuration()->lastUsedSaveLocationType();
-    if (!shouldAsk && lastUsed != SaveLocationType::Undefined) {
-        return RetVal<SaveLocationType>::make_ok(lastUsed);
-    }
-
-    return askSaveLocationType();
+    // Listening Tree: projects are always saved on the computer; there is no
+    // "How would you like to save?" (computer or audio.com) question (upstream asks with
+    // askSaveLocationType() unless told not to)
+    return RetVal<SaveLocationType>::make_ok(SaveLocationType::Local);
 }
 
 RetVal<SaveLocationType> OpenSaveProjectScenario::askSaveLocationType() const
