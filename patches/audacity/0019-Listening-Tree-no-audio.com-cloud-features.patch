+++ b/src/appshell/qml/Audacity/AppShell/appmenumodel.cpp
@@ -249,16 +249,15 @@ MenuItem* AppMenuModel::makeFileMenu()
         makeSeparator(),
 
         makeMenuItem("file-save"),
-        makeMenuItem("file-save-to-cloud"),
         makeMenuItem("file-save-as"),
-        makeMenuItem("audacity://cloud/update-audio-preview"),
+        // Listening Tree: no "Save to cloud…" or "Update cloud audio preview" (audio.com)
 
         makeSeparator(),
 
         makeMenuItem("export-audio"),
         // makeMenu(TranslatableString("appshell-menu-export-other", "&Export other"), makeExportItems(), "menu-export-other"),
         makeMenuItem("export-labels"),
-        makeMenuItem("file-share-audio"),
+        // Listening Tree: no "Share audio" (audio.com)
 
         makeSeparator(),
 
diff --git a/src/au3cloud/internal/au3audiocomservice.cpp b/src/au3cloud/internal/au3audiocomservice.cpp
index 1eea9abf7156906e5f43c0adce2f7e2412b7c5af..ff705cd71f5ebc7b7db7cc645c88ebd8c72421c2 100644
--- a/src/au3cloud/internal/au3audiocomservice.cpp
+++ b/src/au3cloud/internal/au3audiocomservice.cpp
@@ -55,7 +55,9 @@ using namespace audacity::cloud::audiocom;
 
 bool Au3AudioComService::enabled() const
 {
-    return true;
+    // Listening Tree: no audio.com (cloud) features. With this off, the app hides sharing,
+    // cloud saving and cloud projects, and refuses them if they are asked for anyway.
+    return false;
 }
 
 namespace {
