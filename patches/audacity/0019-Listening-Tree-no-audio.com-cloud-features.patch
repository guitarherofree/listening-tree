From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Listening Tree <listening-tree@localhost>
Date: Sun, 15 Nov 2026 13:25:38 -0500
Subject: [PATCH] Listening Tree: no audio.com (cloud) features


diff --git a/buildscripts/packaging/MacOS/MacOSXBundleInfo.plist.in b/buildscripts/packaging/MacOS/MacOSXBundleInfo.plist.in
index 7e5744884520bf82e6e9961bea53d82540fbe3d8..9cd9e9f6830d135e4760813291eab8034d8ba95d 100644
--- a/buildscripts/packaging/MacOS/MacOSXBundleInfo.plist.in
+++ b/buildscripts/packaging/MacOS/MacOSXBundleInfo.plist.in
@@ -244,19 +244,7 @@
 		</dict>
 	</array>
 
-    <key>CFBundleURLTypes</key>
-    <array>
-        <dict>
-            <key>CFBundleTypeRole</key>
-            <string>Editor</string>
-            <key>CFBundleURLName</key>
-            <string>org.audacityteam.audacity.audacityurl</string>
-            <key>CFBundleURLSchemes</key>
-            <array>
-                <string>audacity</string>
-            </array>
-        </dict>
-    </array>
+    <!-- Listening Tree: no audacity:// URL scheme; it was for audio.com sign-in and cloud projects -->
 
     <key>ATSApplicationFontsPath</key>
     <string>fonts</string>
diff --git a/src/appshell/qml/Audacity/AppShell/appmenumodel.cpp b/src/appshell/qml/Audacity/AppShell/appmenumodel.cpp
index 5a0354eadc84337a93174f4954447593a3d6083f..55ff532dee528389eb0c59f43b345335dc1ae104 100644
