+void StartupScenario::bringToFrontIfReopenedByUpdater()
+{
+    //! Listening Tree: after an in-app update, packaging/macos/install-update.sh reopens the app
+    //! from a background script. macOS does not bring an app opened that way to the front, so the
+    //! new version would start hidden behind other windows. The script leaves this marker.
+    //! The first start of a new version counts too, because that version was installed by the
+    //! previous version's script, which may predate the marker.
+    const QString marker = QStandardPaths::writableLocation(QStandardPaths::AppLocalDataLocation)
+                           + QStringLiteral("/update/relaunched-after-update");
+    const bool reopenedByUpdater = QFile::exists(marker);
+    if (reopenedByUpdater) {
+        QFile::remove(marker);
+    }
+
+    const std::string lastStarted = muse::settings()->value(LT_LAST_STARTED_VERSION_KEY).toString();
+    const bool newVersion = lastStarted != LT_APP_VERSION;
+    if (newVersion) {
+        muse::settings()->setSharedValue(LT_LAST_STARTED_VERSION_KEY, muse::Val(std::string(LT_APP_VERSION)));
+    }
+
+    if (!reopenedByUpdater && !newVersion) {
+        return;
+    }
+
+    // Twice: once the window is up, and again in case the first request came too early
+    for (const int delayMs : { 300, 1500 }) {
+        QTimer::singleShot(delayMs, qApp, [this]() {
+            if (!mainWindow()) {
+                return;
+            }
+            if (QWindow* window = mainWindow()->qWindow()) {
+                if (!window->isVisible()) {
+                    window->show();
+                }
+                // On macOS raising the window also activates the app (Qt's cocoa raise())
+                mainWindow()->requestShowOnFront();
+                window->requestActivate();
+            }
+        });
+    }
+}
