diff --git a/src/appshell/qml/Audacity/AppShell/ProjectPage/ProjectPage.qml b/src/appshell/qml/Audacity/AppShell/ProjectPage/ProjectPage.qml
index bf9fbbcd58071a65b21930abe19a834243a8e689..31e565e7e3a89f5c73f008c93205bb3bb1bd2c4e 100644
