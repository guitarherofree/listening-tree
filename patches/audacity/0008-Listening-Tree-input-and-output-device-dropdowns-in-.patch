diff --git a/src/projectscene/view/toolbars/audiodevicetoolbaritem.cpp b/src/projectscene/view/toolbars/audiodevicetoolbaritem.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..36529555bbd39d0c708659c2b5f7846782f3b1a3
--- /dev/null
+++ b/src/projectscene/view/toolbars/audiodevicetoolbaritem.cpp
@@ -0,0 +1,128 @@
+/*
+* Audacity: A Digital Audio Editor
+*
+* Listening Tree: input / output device dropdowns in the playback toolbar.
+*/
+#include "audiodevicetoolbaritem.h"
+
+#include "framework/global/containers.h"
+#include "framework/global/translation.h"
+
+using namespace au::projectscene;
+using namespace muse::ui;
+using namespace muse::uicomponents;
+using namespace muse::actions;
+
+// The same actions the "Audio setup" menu uses (handled by the playback controller)
+static const ActionQuery CHANGE_PLAYBACK_DEVICE_QUERY("action://playback/change-playback-device");
+static const ActionQuery CHANGE_RECORDING_DEVICE_QUERY("action://playback/change-recording-device");
+
+AudioDeviceToolBarItem::AudioDeviceToolBarItem(const UiAction& action, ToolBarItemType::Type type,
+                                               Direction direction, QObject* parent)
+    : ToolBarItem(action, type, parent), m_direction(direction)
+{
+    audioDriverController()->configurationChanged().onReceive(this, [this](const audio::AudioConfigurationDelta&) {
+        rebuild();
+    });
+    audioDriverController()->audioDeviceListChanged().onNotify(this, [this]() {
+        rebuild();
+    });
+
+    rebuild();
+}
+
+QString AudioDeviceToolBarItem::label() const
+{
+    //: Label of the recording device dropdown in the playback toolbar
+    return m_direction == Direction::Input ? muse::qtrc("projectscene", "Input")
+           //: Label of the playback device dropdown in the playback toolbar
+           : muse::qtrc("projectscene", "Output");
+}
+
+QString AudioDeviceToolBarItem::currentValue() const
+{
+    return m_currentValue;
+}
+
+QVariantList AudioDeviceToolBarItem::availableDevices() const
+{
+    return menuItemListToVariantList(m_items);
+}
+
+void AudioDeviceToolBarItem::handleMenuItem(const QString& itemId)
+{
+    if (itemId.isEmpty()) {
+        return;
+    }
+
+    dispatcher()->dispatch(ActionQuery(itemId.toStdString()));
+}
+
+MenuItem* AudioDeviceToolBarItem::makeDeviceItem(const QString& id, const QString& title, bool checked)
+{
+    MenuItem* item = new MenuItem(this);
+    item->setId(id);
+
+    UiAction action;
+    action.checkable = Checkable::Yes;
+    item->setAction(action);
+
+    UiActionState state;
+    state.enabled = true;
+    state.checked = checked;
+    item->setState(state);
+
+    item->setTitle(muse::TranslatableString::untranslatable(muse::String::fromStdString(title.toStdString())));
+
+    return item;
+}
+
+void AudioDeviceToolBarItem::rebuild()
+{
+    const bool input = m_direction == Direction::Input;
+    const audio::AudioConfiguration config = audioDriverController()->configuration();
+    const audio::AudioDeviceSelection selected = input ? config.inputDevice : config.outputDevice;
+    const std::vector<std::string> devices = input ? audioDriverController()->inputDevices()
+                                             : audioDriverController()->outputDevices();
+    const std::string systemDefault = input ? audioDriverController()->systemDefaultInputDevice(config.api)
+                                      : audioDriverController()->systemDefaultOutputDevice(config.api);
+    const ActionQuery baseQuery = input ? CHANGE_RECORDING_DEVICE_QUERY : CHANGE_PLAYBACK_DEVICE_QUERY;
+
+    const bool usesSystemDefault = !selected.has_value() || !muse::contains(devices, selected.value());
+
+    // The open menu may still show the old items, so let them go once control returns to the event loop
+    for (MenuItem* item : std::as_const(m_items)) {
+        item->deleteLater();
+    }
+    m_items.clear();
+
+    if (!devices.empty()) {
+        ActionQuery defaultQuery = baseQuery;
+        defaultQuery.addParam("is_default_device", muse::Val(true));
+        const QString defaultTitle = systemDefault.empty()
+                                     ? muse::qtrc("projectscene", "System default")
+                                     //: %1 is the device the system default currently resolves to
+                                     : muse::qtrc("projectscene", "System default: %1").arg(QString::fromStdString(systemDefault));
+        m_items << makeDeviceItem(QString::fromStdString(defaultQuery.toString()), defaultTitle, usesSystemDefault);
+
+        MenuItem* separator = new MenuItem(this);
+        separator->setAction(UiAction());
+        m_items << separator;
+    }
+
+    for (size_t i = 0; i < devices.size(); ++i) {
+        ActionQuery query = baseQuery;
+        query.addParam("device_index", muse::Val(static_cast<int>(i)));
+        const bool checked = !usesSystemDefault && selected.value() == devices.at(i);
+        m_items << makeDeviceItem(QString::fromStdString(query.toString()), QString::fromStdString(devices.at(i)), checked);
+    }
+
+    if (devices.empty()) {
+        m_currentValue = input ? muse::qtrc("projectscene", "No recording device")
+                         : muse::qtrc("projectscene", "No playback device");
+    } else {
+        m_currentValue = QString::fromStdString(usesSystemDefault ? systemDefault : selected.value());
+    }
+
+    emit devicesChanged();
+}
diff --git a/src/projectscene/view/toolbars/audiodevicetoolbaritem.h b/src/projectscene/view/toolbars/audiodevicetoolbaritem.h
new file mode 100644
index 0000000000000000000000000000000000000000..4086e5597f5cb9d6bc9737f47a911be219a08470
--- /dev/null
+++ b/src/projectscene/view/toolbars/audiodevicetoolbaritem.h
@@ -0,0 +1,55 @@
+/*
+* Audacity: A Digital Audio Editor
+*
+* Listening Tree: a dropdown in the playback toolbar for choosing the recording
+* (input) or playback (output) device. It uses the same actions as the
+* "Audio setup" menu, so both stay in step.
+*/
+#pragma once
+
+#include "modularity/ioc.h"
+#include "actions/iactionsdispatcher.h"
+#include "audio/driver/iaudiodrivercontroller.h"
+
+#include "uicomponents/qml/Muse/UiComponents/toolbaritem.h"
+#include "uicomponents/qml/Muse/UiComponents/menuitem.h"
+
+namespace au::projectscene {
+class AudioDeviceToolBarItem : public muse::uicomponents::ToolBarItem
+{
+    Q_OBJECT
+
+    Q_PROPERTY(QString label READ label CONSTANT FINAL)
+    Q_PROPERTY(QString currentValue READ currentValue NOTIFY devicesChanged FINAL)
+    Q_PROPERTY(QVariantList availableDevices READ availableDevices NOTIFY devicesChanged FINAL)
+
+    muse::GlobalInject<audio::IAudioDriverController> audioDriverController;
+    muse::ContextInject<muse::actions::IActionsDispatcher> dispatcher{ this };
+
+public:
+    enum class Direction {
+        Input,
+        Output
+    };
+
+    explicit AudioDeviceToolBarItem(const muse::ui::UiAction& action, muse::uicomponents::ToolBarItemType::Type type,
+                                    Direction direction, QObject* parent = nullptr);
+
+    Q_INVOKABLE void handleMenuItem(const QString& itemId);
+
+    QString label() const;
+    QString currentValue() const;
+    QVariantList availableDevices() const;
+
+signals:
+    void devicesChanged();
+
+private:
+    void rebuild();
+    muse::uicomponents::MenuItem* makeDeviceItem(const QString& id, const QString& title, bool checked);
+
+    const Direction m_direction;
+    muse::uicomponents::MenuItemList m_items;
+    QString m_currentValue;
+};
+}
