-        { SNAP_ACTION_CODE, PlaybackToolBarModel::SNAP }
+        { SNAP_ACTION_CODE, PlaybackToolBarModel::SNAP },
+        { RECORDING_DEVICE_ACTION_CODE, PlaybackToolBarModel::AUDIO_DEVICE },
+        { PLAYBACK_DEVICE_ACTION_CODE, PlaybackToolBarModel::AUDIO_DEVICE }
     };
 
     return muse::value(types, actionCode, PlaybackToolBarModel::PROJECT_CONTROL);
@@ -315,6 +322,11 @@ void PlaybackToolBarModel::updateActions()
             continue;
         }
 
+        // Listening Tree: no snap control in the toolbar, even in a layout saved before it was removed
+        if (citem.action == SNAP_ACTION_CODE) {
