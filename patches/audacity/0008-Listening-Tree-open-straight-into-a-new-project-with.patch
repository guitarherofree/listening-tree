+bool ProjectActionsController::isUntouchedNewProject(const IAudacityProjectPtr& project) const
+{
+    // A project made by "New" (or at startup) that has never been saved and has no tracks yet.
+    // New projects always count as unsaved, so without this check quitting right after
+    // launch would ask to save an empty project.
+    if (!project || !project->isNewlyCreated() || project->isImported() || project->isCloudProject()) {
+        return false;
+    }
+
+    const auto tracks = project->trackeditProject();
+    return tracks && tracks->trackIdList().empty();
+}
+
+void ProjectActionsController::showProjectOrStartNew()
+{
+    if (!globalContext()->currentProject() && !createProjectInCurrentWindow()) {
+        LOGE() << "Failed to create a new project";
+        openPageIfNeed(HOME_PAGE_URI); // last resort, so the window isn't blank
+        return;
+    }
+
+    openPageIfNeed(PROJECT_PAGE_URI);
+}
