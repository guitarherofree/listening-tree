From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Listening Tree <listening-tree@localhost>
Date: Sat, 14 Nov 2026 20:01:34 -0500
Subject: [PATCH] Listening Tree: open straight into a new project, without the
 welcome dialog or Home page


diff --git a/src/appshell/internal/applicationactioncontroller.cpp b/src/appshell/internal/applicationactioncontroller.cpp
index c18a97f9959c35ce0f65c81b943fd0681c6ac167..889451fec79a4e214f2e5b9ecf8791859e0dd6c3 100644
--- a/src/appshell/internal/applicationactioncontroller.cpp
+++ b/src/appshell/internal/applicationactioncontroller.cpp
@@ -58,6 +58,11 @@ void ApplicationActionController::preInit()
         }
         QWindow* window = mainWindow() ? mainWindow()->qWindow() : nullptr;
         if (window && !window->isVisible()) {
+            // Listening Tree: closing the window closed its project (there is no Home page),
+            // so it comes back with a new, empty one, ready to record
+            if (!isProjectOpened()) {
+                dispatcher()->dispatch("file-new");
+            }
             window->show();
             window->requestActivate();
         }
