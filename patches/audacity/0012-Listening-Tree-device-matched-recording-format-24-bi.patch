diff --git a/au3/modules/import-export/mod-pcm/ExportPCM.cpp b/au3/modules/import-export/mod-pcm/ExportPCM.cpp
index cf4d6163819137c96097eba5aa881aa5f614a0ae..907d4e7425f1d1a599895ef1e90b4beb6aa145b0 100644
--- a/au3/modules/import-export/mod-pcm/ExportPCM.cpp
+++ b/au3/modules/import-export/mod-pcm/ExportPCM.cpp
@@ -129,6 +129,12 @@ ExportOptionsSFTypedEditor::ExportOptionsSFTypedEditor(int type)
     mEncodingOption.title = TranslatableString("import-export", "Encoding");
     mEncodingOption.flags = ExportOption::TypeEnum;
     mEncodingOption.defaultValue = mEncodingOption.values[0];
+    // Listening Tree: 24-bit PCM by default, matching what is recorded
+    const auto pcm24 = std::find(mEncodingOption.values.begin(), mEncodingOption.values.end(),
+                                 ExportValue(SF_FORMAT_PCM_24));
+    if (pcm24 != mEncodingOption.values.end()) {
+        mEncodingOption.defaultValue = *pcm24;
+    }
 
     mEncoding = *std::get_if<int>(&mEncodingOption.defaultValue);
 }
@@ -172,6 +178,16 @@ ExportOptionsSFTypedEditor::SampleRateList ExportOptionsSFTypedEditor::GetSample
 
 void ExportOptionsSFTypedEditor::Load(const audacity::BasicSettings& config)
 {
+    // Listening Tree: switch WAV exports to the 24-bit default once, even if an earlier
+    // encoding was saved; an encoding chosen after that is kept
+    static const wxString kApplied = wxT("/ListeningTree/Export24BitWavApplied");
+    if (mType == SF_FORMAT_WAV && !config.Read(kApplied, false)) {
+        gPrefs->Write(kApplied, true);
+        SaveEncoding(*gPrefs, mType, mEncoding);
+        gPrefs->Flush();
+        return;
+    }
+
     mEncoding = LoadEncoding(config, mType, mEncoding);
 }
 
