 const muse::Settings::Key RECORDING_SOURCE("au3audio", "AudioIO/RecordingSource");
 const muse::Settings::Key RECORDING_SOURCE_INDEX("au3audio", "AudioIO/RecordingSourceIndex");
 const muse::Settings::Key ASIO_USE_DEVICE_SAMPLE_RATE("au3audio", "AudioIO/ASIO/UseDeviceSampleRate");
+// Listening Tree: the device (and rate) whose format was last made the default for new projects
+const muse::Settings::Key LT_DEVICE_FORMAT_APPLIED("au3audio", "ListeningTree/DeviceFormatAppliedFor");
+
+// Listening Tree: devices whose format becomes the default for new projects when connected,
+// most preferred first (matched case-insensitively against the device name)
+constexpr const char* LT_PREFERRED_RECORDING_DEVICES[] = { "fm3", "nano cortex" };
+//! Both devices run at a fixed 48 kHz / 24-bit over USB. The rate is not probed: on macOS
+//! every rate "works" (CoreAudio converts), so the highest one found would be 384 kHz,
+//! which is only the device's 48 kHz upsampled, at 8 times the file size.
+constexpr long LT_DEVICE_SAMPLE_RATE = 48000;
 
 std::string preferredAudioHost(const std::vector<std::string>& hosts)
 {
@@ -184,6 +194,8 @@ void Au3AudioDriverController::init()
     settings()->setLocalValue(INPUT_CHANNELS, muse::Val(inputChannels));
     m_configuration = configurationFromSettings();
 
+    applyPreferredDeviceDefaults();
+
     systemAudioDevicesListener()->systemDevicesChanged().onNotify(this, [this]() {
         onSystemDevicesChanged();
     });
@@ -216,6 +228,8 @@ void Au3AudioDriverController::onSystemDevicesChanged()
         return;
     }
 
+    applyPreferredDeviceDefaults(); // Listening Tree: e.g. an FM3 was just plugged in
+
     const auto after = m_configuration;
     const std::string outputDevice = effectiveOutputDevice(after.api, after.outputDevice);
     const std::string inputDevice = effectiveInputDevice(after.api, after.inputDevice);
@@ -228,6 +242,44 @@ void Au3AudioDriverController::onSystemDevicesChanged()
     }
 }
 
+void Au3AudioDriverController::applyPreferredDeviceDefaults()
+{
+    //! Listening Tree: when a Fractal Audio FM3 is connected (or else a Neural DSP Nano Cortex),
+    //! new projects default to the format that device records: 48 kHz, 24-bit. This is done
+    //! once per device and rate, so a format chosen afterwards in Preferences sticks until a
+    //! different preferred device turns up.
+    const auto& maps = DeviceManager::Instance()->GetInputDeviceMaps();
+
+    for (const char* wanted : LT_PREFERRED_RECORDING_DEVICES) {
+        const auto it = std::find_if(maps.begin(), maps.end(), [&](const DeviceSourceMap& map) {
+            return map.hostString == m_configuration.api
+                   && map.deviceString.Lower().Contains(wxString::FromUTF8(wanted));
+        });
+        if (it == maps.end()) {
+            continue;
+        }
+
+        const long bestRate = LT_DEVICE_SAMPLE_RATE;
+        const std::string marker = wxToStdString(it->deviceString) + " @ " + std::to_string(bestRate);
+        if (settings()->value(LT_DEVICE_FORMAT_APPLIED).toString() == marker) {
+            return;
+        }
+
+        AudioConfigurationChange change;
+        change.defaultSampleRate = static_cast<uint64_t>(bestRate);
+        change.defaultSampleFormat = displaySampleFormat("Format24Bit");
+
+        const ApplyResult result = apply({}, change);
+        if (result.succeeded()) {
+            settings()->setLocalValue(LT_DEVICE_FORMAT_APPLIED, muse::Val(marker));
+            LOGI() << "New projects now default to " << bestRate << " Hz, 24-bit (" << marker << ")";
+        } else {
+            LOGW() << "Could not make " << marker << " the default format, status: " << static_cast<int>(result.status);
+        }
+        return;
+    }
+}
+
 void Au3AudioDriverController::initDefaults()
 {
     const auto availableApis = apis();
