+/*
+* Audacity: A Digital Audio Editor
+*
+* Listening Tree: the meter part of a classic (Audacity 3 style) meter row: L and R level
+* bars across the full width, the dB scale under them, and a volume slider over them.
+*/
+import QtQuick
+
+import Muse.Ui
+import Muse.UiComponents
+
+import Audacity.Playback
+
+Item {
+    id: root
+
+    property var meterModel: null
+    property bool stereo: true
+
+    property real volumeLevel: 0
+    property real leftPressure: -145
+    property real leftRMS: -145
+    property real rightPressure: -145
+    property real rightRMS: -145
+
+    property NavigationPanel navigationPanel: null
+    property int navigationOrder: 0
+    property string volumeAccessibleName: ""
+
+    signal volumeLevelChangeRequested(var level)
+
+    implicitHeight: 28
+
+    function resetMeters() {
+        leftMeter.reset()
+        leftMeter.resetClipped()
+        rightMeter.reset()
+        rightMeter.resetClipped()
+    }
+
+    Column {
+        id: channelLabels
+
+        anchors.left: parent.left
+        anchors.top: parent.top
+        anchors.topMargin: 1
+
+        width: 10
+        spacing: 0
+
+        Text {
+            width: parent.width
+            height: root.stereo ? 8 : 14
+            text: root.stereo ? "L" : ""
+            color: ui.theme.fontPrimaryColor
+            font.pixelSize: 8
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+        }
+
+        Text {
+            width: parent.width
+            height: 8
+            visible: root.stereo
+            text: "R"
+            color: ui.theme.fontPrimaryColor
+            font.pixelSize: 8
+            horizontalAlignment: Text.AlignHCenter
+            verticalAlignment: Text.AlignVCenter
+        }
+    }
+
+    Item {
+        id: meterArea
+
+        anchors.left: channelLabels.right
+        anchors.leftMargin: 4
+        anchors.right: parent.right
+        anchors.top: parent.top
+        anchors.bottom: parent.bottom
+
+        Column {
+            id: bars
+
+            anchors.fill: parent
+            anchors.topMargin: 2
+
+            spacing: 2
+
+            HorizontalVolumePressureMeter {
+                id: leftMeter
+
+                x: ruler.x + ruler.leftTextMargin
+                width: ruler.effectiveWidth + leftMeter.overloadTotalSpace
+                height: root.stereo ? 6 : 14
+
+                meterModel: root.meterModel
+                currentVolumePressure: root.leftPressure
+                currentRMS: root.leftRMS
+
+                enabled: root.enabled
+            }
+
+            HorizontalVolumePressureMeter {
+                id: rightMeter
+
+                x: ruler.x + ruler.leftTextMargin
+                width: ruler.effectiveWidth + leftMeter.overloadTotalSpace
+
+                visible: root.stereo
+
+                meterModel: root.meterModel
+                currentVolumePressure: root.rightPressure
+                currentRMS: root.rightRMS
+
+                enabled: root.enabled
+            }
+
+            HorizontalVolumePressureRuler {
+                id: ruler
+
+                anchors.left: parent.left
+                anchors.right: parent.right
+                anchors.rightMargin: leftMeter.overloadWidth
+
+                meterModel: root.meterModel
+            }
+        }
+
+        VolumeSlider {
+            id: volumeSlider
+
+            anchors.left: parent.left
+            anchors.leftMargin: ruler.leftTextMargin - volumeSlider.handleWidth / 2
+            anchors.right: parent.right
+            anchors.rightMargin: leftMeter.overloadTotalSpace
+            anchors.top: parent.top
+            anchors.topMargin: 1
+
+            meterModel: root.meterModel
+            volumeLevel: root.volumeLevel
+
+            enabled: root.enabled
+
+            navigation.panel: root.navigationPanel
+            navigation.order: root.navigationOrder
+            navigation.accessible.name: root.volumeAccessibleName
+
+            onVolumeLevelMoved: function (level) {
+                root.resetMeters()
+                root.volumeLevelChangeRequested(Math.round(level * 100) / 100)
+            }
+
+            onHandlePressed: {
+                root.resetMeters()
+            }
+
+            onDecreaseRequested: {
+                if (volumeLevel <= from) {
+                    return
+                }
+                root.volumeLevelChangeRequested(Math.round(volumeLevel * 100) / 100 - stepSize)
+            }
+
+            onIncreaseRequested: {
+                if (volumeLevel >= to) {
+                    return
+                }
+                root.volumeLevelChangeRequested(Math.round(volumeLevel * 100) / 100 + stepSize)
+            }
+        }
+
+        // Clicking the clip indicator at the right end clears it
+        MouseArea {
+            anchors.top: bars.top
+            anchors.bottom: bars.bottom
+            anchors.right: bars.right
+
+            width: volumeSlider.handleWidth
+            z: 10
+
+            enabled: volumeSlider.handleX < (volumeSlider.width - volumeSlider.handleWidth - leftMeter.overloadWidth)
+
+            onClicked: {
+                root.resetMeters()
+            }
+        }
+    }
+}
