From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Listening Tree <listening-tree@localhost>
Date: Sun, 15 Nov 2026 14:01:57 -0500
Subject: [PATCH] Listening Tree: classic toolbar, like Audacity 3


diff --git a/src/appshell/qml/Audacity/AppShell/ProjectPage/ProjectPage.qml b/src/appshell/qml/Audacity/AppShell/ProjectPage/ProjectPage.qml
index 642070922485924e410f0bc921278c912c6613cc..db502d103f75b825cb4fb0c4ba5b13dc785e6854 100644
--- a/src/appshell/qml/Audacity/AppShell/ProjectPage/ProjectPage.qml
+++ b/src/appshell/qml/Audacity/AppShell/ProjectPage/ProjectPage.qml
@@ -176,10 +176,13 @@ DockPage {
             dropDestinations: [root.toolBarTopDropDestination, root.toolBarBottomDropDestination]
 
             minimumWidth: 300
-            thickness: 48 /* see PlaybackToolBar rowHeight */
+            // Listening Tree: the classic toolbar has four rows: two meters, transport, devices
+            thickness: 152 /* ClassicToolBar: 28 + 28 + 48 + 28 px rows, 4 px gaps and margins */
             resizable: true
 
-            PlaybackToolBar {
+            // Listening Tree: Audacity 3 style toolbar (meters, large transport buttons,
+            // selection, large time, devices) in place of PlaybackToolBar
+            ClassicToolBar {
                 id: playbackToolBarContent
 
                 floating: playbackToolBar.floating
@@ -310,19 +313,5 @@ DockPage {
         }
     }
 
-    statusBar: DockStatusBar {
-        objectName: pageModel.statusBarName()
-
-        property int thickness: 40
-
-        height: thickness
-        minimumHeight: thickness
-        maximumHeight: thickness
-
-        navigationSection: content.navigationSection
-
-        ProjectStatusBar {
-            id: content
-        }
-    }
+    // Listening Tree: no status bar; the selection (start, end or length) is in the toolbar
 }
diff --git a/src/projectscene/internal/projectsceneuiactions.cpp b/src/projectscene/internal/projectsceneuiactions.cpp
index f3058b0f823b2ea878b27915c667d7027dc55929..fc3291f43e8a51aae7dc483af7f0e1d17f4c63bb 100644
--- a/src/projectscene/internal/projectsceneuiactions.cpp
+++ b/src/projectscene/internal/projectsceneuiactions.cpp
@@ -160,6 +160,22 @@ static UiActionList STATIC_ACTIONS = {
              //: Action description: shown as a tooltip; can be a full sentence
              TranslatableString("action_description", "Choose the device to play through")
              ),
+    UiAction("lt-audio-host",
+             au::context::UiCtxAny,
+             au::context::CTX_ANY,
+             //: Action title: shown as a menu item or a button label; keep it short
+             TranslatableString("action", "Audio host"),
+             //: Action description: shown as a tooltip; can be a full sentence
+             TranslatableString("action_description", "Choose the audio system to use")
+             ),
+    UiAction("lt-recording-channels",
+             au::context::UiCtxAny,
+             au::context::CTX_ANY,
+             //: Action title: shown as a menu item or a button label; keep it short
+             TranslatableString("action", "Recording channels"),
+             //: Action description: shown as a tooltip; can be a full sentence
+             TranslatableString("action_description", "Choose how many channels to record")
+             ),
     UiAction("minutes-seconds-ruler",
              au::context::UiCtxAny,
              au::context::CTX_ANY,
diff --git a/src/projectscene/projectscene.qrc b/src/projectscene/projectscene.qrc
index f53c9f56bd88385314df53e8a7da1d9c3a213b98..693a31720f5950027f5b6554483924b4086ddd3f 100644
--- a/src/projectscene/projectscene.qrc
+++ b/src/projectscene/projectscene.qrc
@@ -44,6 +44,8 @@
         <file>qml/Audacity/ProjectScene/common/TracksListView.qml</file>
         <file>qml/Audacity/ProjectScene/statusbar/SelectionStatus.qml</file>
         <file>qml/Audacity/ProjectScene/toolbars/PlaybackToolBar.qml</file>
+        <file>qml/Audacity/ProjectScene/toolbars/ClassicToolBar.qml</file>
+        <file>qml/Audacity/ProjectScene/toolbars/internal/ClassicMeter.qml</file>
         <file>qml/Audacity/ProjectScene/toolbars/internal/CustomiseView.qml</file>
         <file>qml/Audacity/ProjectScene/toolbars/internal/PlaybackToolBarActionDelegate.qml</file>
         <file>qml/Audacity/ProjectScene/toolbars/internal/PlaybackToolBarCustomisePopup.qml</file>
diff --git a/src/projectscene/qml/Audacity/ProjectScene/qmldir b/src/projectscene/qml/Audacity/ProjectScene/qmldir
index 505595b4d10f9cd052a989d288b5d9730d3307ab..e2a2d5e4919370f7f1269e34a4d16399c389bee8 100644
--- a/src/projectscene/qml/Audacity/ProjectScene/qmldir
+++ b/src/projectscene/qml/Audacity/ProjectScene/qmldir
@@ -2,6 +2,7 @@ module Audacity.ProjectScene
 ProjectToolBar 1.0 toolbars/ProjectToolBar.qml
 UndoRedoToolBar 1.0 toolbars/UndoRedoToolBar.qml
 PlaybackToolBar 1.0 toolbars/PlaybackToolBar.qml
+ClassicToolBar 1.0 toolbars/ClassicToolBar.qml
 WorkspacesToolBar 1.0 toolbars/WorkspacesToolBar.qml
 RealtimeEffectListItem 1.0 trackspanel/RealtimeEffectListItem.qml
 RealtimeEffectListItemButtonBackground 1.0 trackspanel/RealtimeEffectListItemButtonBackground.qml
diff --git a/src/projectscene/qml/Audacity/ProjectScene/toolbars/ClassicToolBar.qml b/src/projectscene/qml/Audacity/ProjectScene/toolbars/ClassicToolBar.qml
new file mode 100644
index 0000000000000000000000000000000000000000..d425e28f9a5dcadde4511d7474575a13c5a6e34e
--- /dev/null
+++ b/src/projectscene/qml/Audacity/ProjectScene/toolbars/ClassicToolBar.qml
@@ -0,0 +1,662 @@
+/*
+* Audacity: A Digital Audio Editor
+*
+* Listening Tree: the toolbar in the style of Audacity 3's classic layout:
+*   - a recording meter row and a playback meter row, each with its level slider
+*   - large transport buttons (Pause, Play, Stop, Skip to start/end, Record, Loop),
+*     the selection's start and end, and a large playback time
+*   - the audio host, recording device, recording channels and playback device
+* The items come from PlaybackToolBarModel in its fixed "classic" layout.
+*/
+import QtQuick
+import QtQuick.Layouts
+
+import Muse.Ui
+import Muse.UiComponents
+
+import Audacity.Playback
+import Audacity.Record
+import Audacity.ProjectScene
+import Audacity.UiComponents
+
+import "internal"
+
+Item {
+    id: root
+
+    property bool floating: false
+
+    property int maximumWidth: 0
+    property int maximumHeight: 0
+
+    property NavigationPanel navigationPanel: NavigationPanel {
+        name: "ClassicToolBar"
+        enabled: root.enabled && root.visible
+        direction: NavigationPanel.Horizontal
+        accessible.name: qsTrc("projectscene", "Playback toolbar")
+    }
+
+    signal relayoutRequested
+
+    width: root.maximumWidth > 0 ? Math.max(prv.minimumContentWidth, root.maximumWidth) : prv.minimumContentWidth
+    height: content.implicitHeight + 2 * prv.margin
+
+    PlaybackToolBarModel {
+        id: toolbarModel
+
+        classicLayout: true
+
+        onItemsChanged: {
+            root.relayoutRequested()
+        }
+    }
+
+    PlaybackStateModel {
+        id: playbackState
+    }
+
+    SelectionStatusModel {
+        id: selectionModel
+    }
+
+    PlaybackMeterModel {
+        id: playbackMeterModel
+    }
+
+    RecordMeterModel {
+        id: recordMeterModel
+    }
+
+    Component.onCompleted: {
+        toolbarModel.load()
+        playbackState.init()
+        selectionModel.init()
+        playbackMeterModel.init()
+        recordMeterModel.init()
+    }
+
+    QtObject {
+        id: prv
+
+        readonly property int margin: 4
+        readonly property int spacing: 6
+        readonly property int meterRowHeight: 28
+        readonly property int transportButtonSize: 44
+        readonly property int smallButtonSize: 28
+
+        readonly property real selectionZoom: 0.82
+        readonly property real timeZoom: 1.5
+
+        readonly property int minimumContentWidth: Math.max(transportRow.implicitWidth, deviceRow.implicitWidth) + 2 * margin
+
+        property bool selectionShowsLength: false
+
+        function findItem(items, code) {
+            if (!items) {
+                return null
+            }
+            for (let i = 0; i < items.length; ++i) {
+                let item = items[i]
+                if (item && item.code === code) {
+                    return item
+                }
+            }
+            return null
+        }
+
+        readonly property var playPauseItem: findItem(toolbarModel.items, "action://playback/toggle-play-pause")
+        readonly property var stopItem: findItem(toolbarModel.items, "action://playback/stop")
+        readonly property var rewindStartItem: findItem(toolbarModel.items, "action://playback/rewind-start")
+        readonly property var rewindEndItem: findItem(toolbarModel.items, "action://playback/rewind-end")
+        readonly property var recordItem: findItem(toolbarModel.items, "action://record/start")
+        readonly property var loopItem: findItem(toolbarModel.items, "toggle-loop-region")
+        readonly property var timeItem: findItem(toolbarModel.items, "playback-time")
+        readonly property var recordLevelItem: findItem(toolbarModel.items, "action://record/level")
+        readonly property var playbackLevelItem: findItem(toolbarModel.items, "action://playback/level")
+        readonly property var hostItem: findItem(toolbarModel.items, "lt-audio-host")
+        readonly property var inputItem: findItem(toolbarModel.items, "lt-recording-device")
+        readonly property var channelsItem: findItem(toolbarModel.items, "lt-recording-channels")
+        readonly property var outputItem: findItem(toolbarModel.items, "lt-playback-device")
+
+        // The recording meter shows the input all the time, not just while recording
+        // (unless "Show mic metering when not recording" is turned off in the mic button's popup)
+        onRecordLevelItemChanged: {
+            if (recordLevelItem) {
+                recordLevelItem.listenMainAudioInput(true)
+            }
+        }
+
+        function activate(item) {
+            if (item && item.enabled) {
+                Qt.callLater(item.activate)
+            }
+        }
+    }
+
+    //! NOTE inline components can't see this file's ids, so they only use ui and their own properties
+    component TransportButton: FlatButton {
+        width: 44
+        height: 44
+        Layout.preferredWidth: 44
+        Layout.preferredHeight: 44
+
+        backgroundRadius: 4
+        iconFont: Qt.font({ family: ui.theme.iconsFont.family, pixelSize: 22 })
+    }
+
+    component VerticalSeparator: Rectangle {
+        Layout.fillHeight: true
+        Layout.topMargin: 4
+        Layout.bottomMargin: 4
+        Layout.leftMargin: 4
+        Layout.rightMargin: 4
+
+        implicitWidth: 1
+        color: ui.theme.strokeColor
+    }
+
+    component DeviceDropdown: DropdownWithTitle {
+        property var itemData: null
+
+        Layout.preferredHeight: 28
+
+        allowOptionToggle: false
+        current: Boolean(itemData) ? itemData.currentValue : ""
+        dropdownAccessibleName: Boolean(itemData) ? itemData.title : ""
+        model: Boolean(itemData) ? itemData.availableDevices : null
+
+        onHandleMenuItem: function (itemId) {
+            if (itemData) {
+                itemData.handleMenuItem(itemId)
+            }
+        }
+    }
+
+    Column {
+        id: content
+
+        anchors.fill: parent
+        anchors.margins: prv.margin
+
+        spacing: 4
+
+        // ---- Recording meter ----
+        RowLayout {
+            id: recordMeterRow
+
+            width: parent.width
+            height: prv.meterRowHeight
+
+            spacing: 4
+
+            RecordLevel {
+                id: recordMeterButton
+
+                Layout.preferredWidth: prv.smallButtonSize
+                Layout.preferredHeight: prv.smallButtonSize
+
+                backgroundRadius: 3
+                icon: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.icon : IconCode.MICROPHONE
+                toolTipTitle: qsTrc("projectscene", "Recording meter")
+                toolTipDescription: qsTrc("projectscene", "Recording level and input monitoring")
+
+                volumeLevel: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.level : 0
+                leftCurrentVolumePressure: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.leftChannelPressure : -145
+                rightCurrentVolumePressure: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.rightChannelPressure : -145
+                recordingChannelsCount: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.recordingChannelsCount : 0
+                isInputMonitoringOn: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.isInputMonitoringOn : false
+                isMicMeteringOn: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.isMicMeteringOn : false
+
+                enabled: Boolean(prv.recordLevelItem) && prv.recordLevelItem.enabled
+
+                navigationPanel: root.navigationPanel
+                navigationOrder: 1
+
+                onVolumeLevelChangeRequested: function (level) {
+                    if (prv.recordLevelItem) {
+                        prv.recordLevelItem.level = level
+                    }
+                }
+
+                onIsInputMonitoringOnChangeRequested: function (enable) {
+                    if (prv.recordLevelItem) {
+                        prv.recordLevelItem.isInputMonitoringOn = enable
+                    }
+                }
+
+                onIsMicMeteringOnChangeRequested: function (enable) {
+                    if (prv.recordLevelItem) {
+                        prv.recordLevelItem.isMicMeteringOn = enable
+                    }
+                }
+            }
+
+            ClassicMeter {
+                id: recordMeter
+
+                Layout.fillWidth: true
+                Layout.preferredHeight: prv.meterRowHeight
+
+                meterModel: recordMeterModel
+                stereo: !Boolean(prv.recordLevelItem) || prv.recordLevelItem.recordingChannelsCount !== 1
+
+                volumeLevel: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.level : 0
+                leftPressure: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.leftChannelPressure : -145
+                rightPressure: Boolean(prv.recordLevelItem) ? prv.recordLevelItem.rightChannelPressure : -145
+
+                enabled: Boolean(prv.recordLevelItem) && prv.recordLevelItem.enabled
+
+                navigationPanel: root.navigationPanel
+                navigationOrder: 2
+                volumeAccessibleName: qsTrc("projectscene", "Recording level")
+
+                onVolumeLevelChangeRequested: function (level) {
+                    if (prv.recordLevelItem) {
+                        prv.recordLevelItem.level = level
+                    }
+                }
+            }
+        }
+
+        // ---- Playback meter ----
+        RowLayout {
+            id: playbackMeterRow
+
+            width: parent.width
+            height: prv.meterRowHeight
+
+            spacing: 4
+
+            FlatButton {
+                id: playbackMeterButton
+
+                Layout.preferredWidth: prv.smallButtonSize
+                Layout.preferredHeight: prv.smallButtonSize
+
+                backgroundRadius: 3
+                icon: IconCode.AUDIO
+                toolTipTitle: qsTrc("playback", "Playback meter settings")
+                accentButton: playbackMeterPopup.isOpened
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 3
+
+                onClicked: {
+                    playbackMeterPopup.toggleOpened()
+                }
+
+                PlaybackMeterCustomisePopup {
+                    id: playbackMeterPopup
+                    model: playbackMeterModel
+                }
+            }
+
+            ClassicMeter {
+                id: playbackMeter
+
+                Layout.fillWidth: true
+                Layout.preferredHeight: prv.meterRowHeight
+
+                meterModel: playbackMeterModel
+
+                volumeLevel: Boolean(prv.playbackLevelItem) ? prv.playbackLevelItem.level : 0
+                leftPressure: Boolean(prv.playbackLevelItem) ? prv.playbackLevelItem.leftChannelPressure : -145
+                leftRMS: Boolean(prv.playbackLevelItem) ? prv.playbackLevelItem.leftChannelRMS : -145
+                rightPressure: Boolean(prv.playbackLevelItem) ? prv.playbackLevelItem.rightChannelPressure : -145
+                rightRMS: Boolean(prv.playbackLevelItem) ? prv.playbackLevelItem.rightChannelRMS : -145
+
+                enabled: Boolean(prv.playbackLevelItem) && prv.playbackLevelItem.enabled
+
+                navigationPanel: root.navigationPanel
+                navigationOrder: 4
+                volumeAccessibleName: qsTrc("playback", "Playback volume")
+
+                onVolumeLevelChangeRequested: function (level) {
+                    if (prv.playbackLevelItem) {
+                        prv.playbackLevelItem.level = level
+                    }
+                }
+            }
+
+            Connections {
+                target: playbackState
+
+                function onIsPlayingChanged() {
+                    if (playbackState.isPlaying) {
+                        playbackMeter.resetMeters()
+                    }
+                }
+            }
+        }
+
+        // ---- Transport, selection and time ----
+        RowLayout {
+            id: transportRow
+
+            height: prv.transportButtonSize + 4
+
+            spacing: prv.spacing
+
+            TransportButton {
+                id: pauseButton
+
+                icon: IconCode.PAUSE_FILL
+                toolTipTitle: qsTrc("projectscene", "Pause")
+                toolTipShortcut: Boolean(prv.playPauseItem) ? prv.playPauseItem.shortcuts : ""
+
+                enabled: Boolean(prv.playPauseItem) && prv.playPauseItem.enabled
+                         && (playbackState.isPlaying || playbackState.isPaused || playbackState.isRecording)
+                accentButton: playbackState.isPaused
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 10
+
+                onClicked: {
+                    prv.activate(prv.playPauseItem)
+                }
+            }
+
+            TransportButton {
+                id: playButton
+
+                icon: IconCode.PLAY_FILL
+                iconColor: playbackState.isPlaying ? ui.theme.fontPrimaryColor : ui.theme.extra["play_color"]
+                accentColor: ui.theme.extra["play_color"]
+                accentButton: playbackState.isPlaying
+                toolTipTitle: qsTrc("projectscene", "Play")
+                toolTipShortcut: Boolean(prv.playPauseItem) ? prv.playPauseItem.shortcuts : ""
+
+                enabled: Boolean(prv.playPauseItem) && prv.playPauseItem.enabled && !playbackState.isRecording
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 11
+
+                onClicked: {
+                    if (!playbackState.isPlaying) {
+                        prv.activate(prv.playPauseItem)
+                    }
+                }
+            }
+
+            TransportButton {
+                id: stopButton
+
+                icon: IconCode.STOP_FILL
+                toolTipTitle: Boolean(prv.stopItem) ? prv.stopItem.title : ""
+                toolTipShortcut: Boolean(prv.stopItem) ? prv.stopItem.shortcuts : ""
+
+                enabled: Boolean(prv.stopItem) && prv.stopItem.enabled
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 12
+
+                onClicked: {
+                    prv.activate(prv.stopItem)
+                }
+            }
+
+            TransportButton {
+                id: rewindStartButton
+
+                icon: IconCode.REWIND_START_FILL
+                toolTipTitle: qsTrc("projectscene", "Skip to start")
+                toolTipShortcut: Boolean(prv.rewindStartItem) ? prv.rewindStartItem.shortcuts : ""
+
+                enabled: Boolean(prv.rewindStartItem) && prv.rewindStartItem.enabled
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 13
+
+                onClicked: {
+                    prv.activate(prv.rewindStartItem)
+                }
+            }
+
+            TransportButton {
+                id: rewindEndButton
+
+                icon: IconCode.REWIND_END_FILL
+                toolTipTitle: qsTrc("projectscene", "Skip to end")
+                toolTipShortcut: Boolean(prv.rewindEndItem) ? prv.rewindEndItem.shortcuts : ""
+
+                enabled: Boolean(prv.rewindEndItem) && prv.rewindEndItem.enabled
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 14
+
+                onClicked: {
+                    prv.activate(prv.rewindEndItem)
+                }
+            }
+
+            TransportButton {
+                id: recordButton
+
+                readonly property bool isRecording: Boolean(prv.recordItem) && prv.recordItem.selected
+
+                icon: IconCode.RECORD_FILL
+                iconColor: isRecording ? ui.theme.backgroundPrimaryColor : ui.theme.extra["record_color"]
+                accentColor: ui.theme.extra["record_color"]
+                accentButton: isRecording
+                toolTipTitle: Boolean(prv.recordItem) ? prv.recordItem.title : ""
+                toolTipShortcut: Boolean(prv.recordItem) ? prv.recordItem.shortcuts : ""
+
+                enabled: Boolean(prv.recordItem) && prv.recordItem.enabled
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 15
+
+                onClicked: {
+                    prv.activate(prv.recordItem)
+                }
+            }
+
+            TransportButton {
+                id: loopButton
+
+                icon: IconCode.LOOP
+                accentButton: Boolean(prv.loopItem) && prv.loopItem.selected
+                toolTipTitle: Boolean(prv.loopItem) ? prv.loopItem.title : ""
+                toolTipShortcut: Boolean(prv.loopItem) ? prv.loopItem.shortcuts : ""
+
+                enabled: Boolean(prv.loopItem) && prv.loopItem.enabled
+
+                navigation.panel: root.navigationPanel
+                navigation.order: 16
+
+                onClicked: {
+                    prv.activate(prv.loopItem)
+                }
+            }
+
+            VerticalSeparator {}
+
+            // Selection: start, and end (or length)
+            ColumnLayout {
+                Layout.alignment: Qt.AlignVCenter
+
+                spacing: 2
+
+                StyledTextLabel {
+                    text: qsTrc("projectscene", "Selection")
+                    enabled: selectionModel.isEnabled
+                }
+
+                FlatButton {
+                    Layout.preferredWidth: prv.smallButtonSize - 4
+                    Layout.preferredHeight: prv.smallButtonSize - 4
+
+                    icon: IconCode.SETTINGS_COG
+                    transparent: true
+                    toolTipTitle: prv.selectionShowsLength ? qsTrc("projectscene", "Show selection start and end")
+                                                           : qsTrc("projectscene", "Show selection start and length")
+
+                    navigation.panel: root.navigationPanel
+                    navigation.order: 20
+
+                    onClicked: {
+                        prv.selectionShowsLength = !prv.selectionShowsLength
+                    }
+                }
+            }
+
+            Item {
+                id: selectionTimes
+
+                Layout.alignment: Qt.AlignVCenter
+                Layout.preferredWidth: Math.max(selectionStart.width, selectionEnd.width) * prv.selectionZoom
+                Layout.preferredHeight: (selectionStart.height + selectionEnd.height + 2) * prv.selectionZoom
+
+                Column {
+                    scale: prv.selectionZoom
+                    transformOrigin: Item.TopLeft
+
+                    spacing: 2
+
+                    Timecode {
+                        id: selectionStart
+
+                        accessibleName: qsTrc("projectscene", "Selection start")
+
+                        value: selectionModel.startTime
+                        mode: TimecodeModeSelector.TimePoint
+                        sampleRate: selectionModel.sampleRate
+                        tempo: selectionModel.tempo
+                        upperTimeSignature: selectionModel.upperTimeSignature
+                        lowerTimeSignature: selectionModel.lowerTimeSignature
+                        currentFormat: selectionModel.currentFormat
+
+                        enabled: selectionModel.isEnabled
+
+                        onValueChangeRequested: function (newValue) {
+                            selectionModel.startTime = newValue
+                        }
+
+                        onCurrentFormatChanged: {
+                            selectionModel.currentFormat = currentFormat
+                        }
+                    }
+
+                    Timecode {
+                        id: selectionEnd
+
+                        accessibleName: prv.selectionShowsLength ? qsTrc("projectscene", "Selection length")
+                                                                 : qsTrc("projectscene", "Selection end")
+
+                        value: prv.selectionShowsLength ? selectionModel.endTime - selectionModel.startTime : selectionModel.endTime
+                        mode: prv.selectionShowsLength ? TimecodeModeSelector.Duration : TimecodeModeSelector.TimePoint
+                        sampleRate: selectionModel.sampleRate
+                        tempo: selectionModel.tempo
+                        upperTimeSignature: selectionModel.upperTimeSignature
+                        lowerTimeSignature: selectionModel.lowerTimeSignature
+                        currentFormat: prv.selectionShowsLength ? selectionModel.durationFormat : selectionModel.currentFormat
+
+                        enabled: selectionModel.isEnabled
+
+                        onValueChangeRequested: function (newValue) {
+                            if (prv.selectionShowsLength) {
+                                selectionModel.endTime = selectionModel.startTime + newValue
+                            } else {
+                                selectionModel.endTime = newValue
+                            }
+                        }
+
+                        onCurrentFormatChanged: {
+                            if (prv.selectionShowsLength) {
+                                selectionModel.durationFormat = currentFormat
+                            } else {
+                                selectionModel.currentFormat = currentFormat
+                            }
+                        }
+                    }
+                }
+            }
+
+            VerticalSeparator {}
+
+            // Playback position, large
+            Item {
+                id: timeDisplay
+
+                Layout.alignment: Qt.AlignVCenter
+                Layout.preferredWidth: timecode.width * prv.timeZoom
+                Layout.preferredHeight: timecode.height * prv.timeZoom
+
+                Timecode {
+                    id: timecode
+
+                    scale: prv.timeZoom
