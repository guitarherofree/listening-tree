+// Listening Tree: exports the audio as a mono 48 kHz WAV (the time selection, or the selected
+// clips, or else the whole project; muted tracks are left out) into ~/Music/Listening Tree/Sent,
+// then opens it in another app by its bundle identifier. The file is kept, because Notation and
+// Golden Ears refer to it rather than copying it.
+void ProjectActionsController::sendAudioToApp(const std::string& bundleId, const std::string& appName,
+                                              const std::string& whereItGoes)
+{
+    const IAudacityProjectPtr project = globalContext()->currentProject();
+    if (!project) {
+        return;
+    }
+
+    const bool selectedOnly = !selectionController()->timeSelectionIsEmpty() || selectionController()->hasSelectedClips();
+
+    QString musicDir = QStandardPaths::writableLocation(QStandardPaths::MusicLocation);
+    if (musicDir.isEmpty()) {
+        musicDir = QDir::homePath() + "/Music";
+    }
+    const QString folder = musicDir + "/Listening Tree/Sent";
+    QDir().mkpath(folder);
+
+    QString name = project->displayName().trimmed();
+    for (QChar& c : name) {
+        if (QStringLiteral("/:\\?%*|\"<>").contains(c)) {
+            c = QChar('-');
+        }
+    }
+    if (name.isEmpty()) {
+        name = "Listening Tree";
+    }
+    const QString stamp = QDateTime::currentDateTime().toString("yyyy-MM-dd HH.mm.ss");
+    const QString filePath = folder + "/" + name + " " + stamp + (selectedOnly ? " (selection)" : "") + ".wav";
+
+    importexport::IExporter::Options options;
+    options[importexport::IExporter::OptionKey::Format] = muse::Val(std::string("WAV (Microsoft)"));
+    options[importexport::IExporter::OptionKey::ProcessType]
+        = muse::Val(selectedOnly ? importexport::ExportProcessType::SELECTED_AUDIO
+                    : importexport::ExportProcessType::FULL_PROJECT_AUDIO);
+    options[importexport::IExporter::OptionKey::ExportChannelsType]
+        = muse::Val(static_cast<int>(importexport::ExportChannelsPref::ExportChannels::MONO));
+    options[importexport::IExporter::OptionKey::ExportChannels] = muse::Val(1);
+    options[importexport::IExporter::OptionKey::ExportSampleRate] = muse::Val(48000);
+
+    const muse::Ret ret = exporter()->exportData(muse::io::path_t(filePath), options, nullptr, project);
+    if (!ret) {
+        if (ret.code() == static_cast<int>(muse::Ret::Code::Cancel)) {
+            return;
+        }
+        const std::string reason = ret.text().empty() ? muse::trc("project", "The audio could not be exported.") : ret.text();
+        toastService()->showError(muse::qtrc("project", "Couldn't send the audio to %1").arg(QString::fromStdString(appName)).toStdString(),
+                                  reason);
+        return;
+    }
+
+    int opened = -1;
+#ifdef Q_OS_MACOS
+    opened = QProcess::execute("/usr/bin/open", { "-b", QString::fromStdString(bundleId), filePath });
+#endif
+    if (opened != 0) {
+        toastService()->showError(muse::qtrc("project", "%1 isn't installed").arg(QString::fromStdString(appName)).toStdString(),
+                                  muse::qtrc("project", "The audio was saved as %1").arg(filePath).toStdString());
+        return;
+    }
+
+    toastService()->showSuccess(muse::qtrc("project", "Sent to %1").arg(QString::fromStdString(appName)).toStdString(),
+                                QFileInfo(filePath).fileName().toStdString() + "\n" + whereItGoes);
+}
