+void ProjectViewState::fitVerticalZoomToAudio(const trackedit::TrackId& trackId, FitMode mode)
+{
+    constexpr float HEADROOM = 1.12f;    // the loudest peak reaches about 90% of the way to the edge
+    constexpr float MIN_BOUND = 0.01f;   // -40 dBFS: anything quieter is noise, not worth zooming into
+    constexpr float FULL_SCALE = 1.0f;
+    constexpr float TOLERANCE = 0.02f;   // ignore changes under 2%, so the view doesn't flicker
+
+    const auto project = globalContext()->currentProject();
+    if (!project) {
+        return;
+    }
+
+    // A dB scale picked by hand on the vertical ruler stays as it is
+    if (static_cast<trackedit::TrackRulerType>(::getTrackRulerType(project, trackId)) != trackedit::TrackRulerType::Linear) {
+        return;
+    }
+
+    const float peak = trackPeak(project, trackId);
+    if (peak <= 0.0f) {
+        return;
+    }
+
+    const float bound = std::clamp(peak * HEADROOM, MIN_BOUND, FULL_SCALE);
+
+    auto it = m_tracks.find(trackId);
+    TrackData& d = it != m_tracks.end() ? it->second : makeTrackData(trackId);
+
+    const auto [au3Min, au3Max] = getVerticalDisplayBounds(project, trackId);
+    const float viewMax = d.verticalDisplayBounds.val.second;
+
+    if (mode == FitMode::IfNeeded) {
+        const bool untouchedDefault = muse::RealIsEqual(au3Min, -1.0f) && muse::RealIsEqual(au3Max, 1.0f);
+        const bool audioOutgrewZoom = bound > au3Max * (1.0f + TOLERANCE);
+        if (!untouchedDefault && !audioOutgrewZoom) {
+            return;
+        }
+    }
+
+    const bool sameAsAu3 = std::fabs(bound - au3Max) <= au3Max * TOLERANCE;
+    const bool sameAsView = std::fabs(bound - viewMax) <= viewMax * TOLERANCE;
+    if (sameAsAu3 && sameAsView) {
+        return;
+    }
+
+    const bool halfWave = muse::RealIsEqual(au3Min, 0.0f);
+    const std::pair<float, float> newBounds = { halfWave ? 0.0f : -bound, bound };
+    setVerticalDisplayBounds(project, trackId, newBounds);
+    d.verticalDisplayBounds.set(newBounds);
+    m_verticalRulerWidth.set(calculateVerticalRulerWidth());
+}
+
+void ProjectViewState::fitAllTracksToAudio()
+{
+    const trackedit::ITrackeditProjectPtr prj = globalContext()->currentTrackeditProject();
+    if (!prj) {
+        return;
+    }
+
+    for (const trackedit::TrackId& trackId : prj->trackIdList()) {
+        const bool justRecorded = m_justRecordedTracks.count(trackId) > 0;
+        fitVerticalZoomToAudio(trackId, justRecorded ? FitMode::Always : FitMode::IfNeeded);
+    }
+    m_justRecordedTracks.clear();
+}
+
+void ProjectViewState::subscribeToRecordingForFit()
+{
+    if (!record()) {
+        return;
+    }
+
+    //! NOTE while recording, the track being recorded is refitted a few times a second,
+    //! so the take grows to fill the track as it gets louder
+    record()->recordPositionChanged().onReceive(this, [this](const muse::secs_t&) {
+        constexpr qint64 LIVE_FIT_INTERVAL_MS = 250;
+        const qint64 now = QDateTime::currentMSecsSinceEpoch();
+        if (now - m_lastLiveFitMs < LIVE_FIT_INTERVAL_MS) {
+            return;
+        }
+        m_lastLiveFitMs = now;
+
+        for (const trackedit::ClipKey& key : record()->recordingClipKeys()) {
+            if (key.trackId == trackedit::INVALID_TRACK) {
+                continue;
+            }
+            m_justRecordedTracks.insert(key.trackId);
+            fitVerticalZoomToAudio(key.trackId, FitMode::Always);
+        }
+    });
+
+    //! NOTE committing the take (a history change, just before this) already refits the tracks
+    //! recorded on; once the recording has fully stopped, they are refitted once more
+    record()->recordingFinished().onNotify(this, [this]() {
+        for (const trackedit::ClipKey& key : record()->recordingClipKeys()) {
+            if (key.trackId != trackedit::INVALID_TRACK) {
+                m_justRecordedTracks.insert(key.trackId);
+            }
+        }
+        m_lastLiveFitMs = 0;
+
+        muse::async::Async::call(this, [this]() {
+            fitAllTracksToAudio();
+        });
     });
 }
 
