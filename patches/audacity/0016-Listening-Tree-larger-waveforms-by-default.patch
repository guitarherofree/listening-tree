+// Listening Tree: the loudest sample of a wave track (0 when it holds no audio)
+float trackPeak(const std::shared_ptr<au::project::IAudacityProject>& project, const au::trackedit::TrackId& trackId)
+{
+    const au::au3::Au3Project* au3Project = reinterpret_cast<const au::au3::Au3Project*>(project->au3ProjectPtr());
+    const au::au3::Au3WaveTrack* waveTrack = au::au3::DomAccessor::findWaveTrack(*au3Project, au::au3::Au3TrackId(trackId));
+    if (waveTrack == nullptr) {
+        return 0.0f;
+    }
+
+    const double t0 = waveTrack->GetStartTime();
+    const double t1 = waveTrack->GetEndTime();
+    if (!(t1 > t0)) {
+        return 0.0f;
+    }
+
+    float peak = 0.0f;
+    for (const auto pChannel : waveTrack->Channels()) {
+        const auto [minValue, maxValue] = WaveChannelUtilities::GetMinMax(*pChannel, t0, t1, false);
+        peak = std::max({ peak, std::fabs(minValue), std::fabs(maxValue) });
+    }
+    return peak;
+}
