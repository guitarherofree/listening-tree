 public:
     explicit AboutModel(QObject* parent = nullptr);
 
+    Q_INVOKABLE QString appName() const; // Listening Tree
     Q_INVOKABLE QString appVersion() const;
     Q_INVOKABLE QString appRevision() const;
     Q_INVOKABLE QVariantMap appUrl() const;
