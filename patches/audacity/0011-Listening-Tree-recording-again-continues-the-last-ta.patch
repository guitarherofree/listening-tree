--- a/src/record/internal/recordcontroller.h
+++ b/src/record/internal/recordcontroller.h
@@ -93,6 +93,10 @@ private:
 
     void setCurrentRecordStatus(RecordStatus status);
 
+    // Listening Tree: recording again continues the last take, on the same track(s)
+    void rememberLastTake();
+    void continueLastTakeIfAtItsEnd();
+
     muse::async::Notification m_isRecordingChanged;
     muse::async::Notification m_isRecordAllowedChanged;
 
@@ -102,6 +106,10 @@ private:
 
     muse::secs_t m_leadInRecordingStartTime = 0.0;
     std::vector<trackedit::TrackId> m_leadInRecordingTrackIds;
+
+    muse::secs_t m_lastRecordPosition = 0.0;
+    muse::secs_t m_lastTakeEnd = -1.0;
+    std::vector<trackedit::TrackId> m_lastTakeTrackIds;
 };
 }
 
