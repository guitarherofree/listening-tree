# The upstream Audacity release that Listening Tree is built from.
#
# To move to a newer Audacity, run:  scripts/upgrade-audacity.sh <tag>
# (see docs/UPSTREAM.md). That script updates these values for you.

AUDACITY_GIT_URL="https://github.com/audacity/audacity.git"
AUDACITY_TAG="Audacity-4.0.2"
AUDACITY_COMMIT="7472497768314bcd4c641ef6dc91e366d92b2fcc"

# Qt version and add-on modules. These mirror upstream's macOS CI
# (.github/workflows/au4_build_macos.yml in the Audacity source).
QT_VERSION="6.10.1"
QT_MODULES="qt5compat qtnetworkauth qtshadertools qtwebsockets qtgraphs qtquick3d"

# Oldest macOS the app supports (Qt 6.10 needs macOS 13).
MACOS_DEPLOYMENT_TARGET="13.0"
