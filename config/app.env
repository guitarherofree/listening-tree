# Listening Tree — app identity.
#
# This is the single source of truth for the app's name, IDs and update source.
# Shell scripts `source` this file and CMake parses it (cmake/ListeningTree.cmake),
# so keep to simple KEY="value" lines.
#
# Changing APP_BUNDLE_ID, APP_SETTINGS_NAME or APP_ORG_* after people have
# installed the app moves where macOS keeps its settings, so treat them as fixed.

# Name shown in the menu bar, Finder, About box and update dialogs.
APP_NAME="Listening Tree"

# macOS bundle identifier.
APP_BUNDLE_ID="com.guitarherofree.listeningtree"

# Settings namespace. Release builds keep settings in
#   ~/Library/Preferences/com.guitarherofree.ListeningTree.plist
#   ~/Library/Application Support/ListeningTree/ListeningTree/
# Development builds add "Dev" to the name so they never touch the installed app's settings.
APP_SETTINGS_NAME="ListeningTree"
APP_ORG_NAME="ListeningTree"
APP_ORG_DOMAIN="guitarherofree.com"

# File-name prefix for release downloads, e.g. ListeningTree-0.2.0-arm64.dmg
APP_ARTIFACT_PREFIX="ListeningTree"

# GitHub repository that publishes releases (owner/name). The in-app updater
# checks https://api.github.com/repos/<GITHUB_REPO>/releases/latest
GITHUB_REPO="guitarherofree/listening-tree"

# Keychain item that holds a read-only GitHub token. Needed only while the
# repository is private. See docs/UPDATING.md.
UPDATE_TOKEN_KEYCHAIN_SERVICE="com.guitarherofree.listeningtree.github-token"
UPDATE_TOKEN_KEYCHAIN_ACCOUNT="github"
